# ============================================================================
# [PRODUCT_NAME] — environment template. Copy to .env and fill in.
# NEVER commit the real .env. Secret scanning (gitleaks) runs in CI.
# ----------------------------------------------------------------------------
# Product display name (placeholder until you choose the real one).
PRODUCT_NAME=LiveChat
# Public-facing domains
SITE_DOMAIN=localhost:4321
APP_DOMAIN=localhost:3000
API_DOMAIN=localhost:4000
PUBLIC_API_ORIGIN=http://localhost:4000
PUBLIC_SITE_ORIGIN=http://localhost:4321
PUBLIC_APP_ORIGIN=http://localhost:3000

# Runtime
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=debug

# ---- Postgres -------------------------------------------------------------
# The app connects as the LEAST-PRIVILEGE runtime role (app_user, NOBYPASSRLS).
# Migrations connect as the migration owner role (app_migrator).
# dev datasource uses superuser only to create roles/db (infra/bootstrap).
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/livechat?schema=public
MIGRATION_DATABASE_URL=postgresql://app_migrator:app_migrator_pw@localhost:5432/livechat?schema=public
# Used only by infra/bootstrap.ts to create roles + database.
BOOTSTRAP_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ---- Redis ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---- Security / crypto ----------------------------------------------------
# 32 random bytes, hex. Used for AES-256-GCM at-rest encryption (TOTP secrets).
# In production load from a KMS/secret manager + rotation plan.
ENCRYPTION_KEY=change-me-32-byte-hex-key-0000000000000000000000000000000000000000
# JWT signing key (access tokens, 10-15 min). Rotate via kid in header.
JWT_SECRET=change-me-access-token-signing-secret-min-32-bytes!!0000000000
JWT_ISSUER=livechat
JWT_AUDIENCE=livechat-app

# ---- Email -----------------------------------------------------------------
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com

# ---- Cookie / session ------------------------------------------------------
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ---- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ---- Testing ---------------------------------------------------------------
TEST_DATABASE_URL=postgresql://app_user:app_password@localhost:5432/livechat_test?schema=public
TEST_MIGRATION_DATABASE_URL=postgresql://app_migrator:app_migrator_pw@localhost:5432/livechat_test?schema=public
