# Place this file at the repo ROOT: Dockerfile.web
# Builds the Astro site + the widget, then packs them INTO the Caddy image.
# Result: Caddy serves the site and /widget.js, and still proxies the API and dashboard.

# ---------- Stage 1: build site + widget ----------
FROM node:22-bookworm-slim AS build
WORKDIR /app
# If you use pnpm 9 locally (run `pnpm -v`), change 10 to 9 here.
RUN npm install -g pnpm@10

COPY . .
RUN pnpm install --frozen-lockfile --filter "@livechat/site..." --filter "@livechat/widget..."

# Public values are baked in at build time (Astro reads PUBLIC_* variables).
ARG PUBLIC_API_ORIGIN
ARG PUBLIC_SITE_ORIGIN
ARG PUBLIC_APP_ORIGIN
ENV PUBLIC_API_ORIGIN=$PUBLIC_API_ORIGIN
ENV PUBLIC_SITE_ORIGIN=$PUBLIC_SITE_ORIGIN
ENV PUBLIC_APP_ORIGIN=$PUBLIC_APP_ORIGIN

RUN pnpm --filter "@livechat/widget" build
RUN pnpm --filter "@livechat/site" build

# ---------- Stage 2: Caddy with the built files ----------
FROM caddy:2
COPY --from=build /app/apps/site/dist/ /srv/site/
# Widget output (assumed apps/widget/dist). Adjust if your esbuild config writes elsewhere.
COPY --from=build /app/apps/widget/dist/ /srv/site/
