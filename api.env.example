# ON THE SERVER ONLY: ~/app/api.env  (given to the API container)
# Copy this file to api.env and fill in. Never commit api.env.
# Every secret here must be NEW and random, never the values from your local .env.

PRODUCT_NAME=LiveChat

# Public hostnames and origins (https in production)
SITE_DOMAIN=yourdomain.com
APP_DOMAIN=app.yourdomain.com
API_DOMAIN=api.yourdomain.com
PUBLIC_SITE_ORIGIN=https://yourdomain.com
PUBLIC_APP_ORIGIN=https://app.yourdomain.com
PUBLIC_API_ORIGIN=https://api.yourdomain.com
# Only add localhost origins if you run the UI locally against this server:
EXTRA_CORS_ORIGINS=

NODE_ENV=production
API_PORT=4000
LOG_LEVEL=info

# ---- Postgres (host is "db", the compose service name) ----
# Use hex passwords (openssl rand -hex 24) so the URL never breaks.
DATABASE_URL=postgresql://app_user:APP_USER_PASSWORD@db:5432/livechat?schema=public
MIGRATION_DATABASE_URL=postgresql://app_migrator:MIGRATOR_PASSWORD@db:5432/livechat?schema=public
# NOTE: BOOTSTRAP_DATABASE_URL (superuser) is NOT stored here on purpose.
# It is passed only when running the one-off bootstrap command.

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- Security / crypto ----
# openssl rand -hex 32   (exactly 32 bytes). Keep a backup: losing it makes
# encrypted 2FA secrets unreadable.
ENCRYPTION_KEY=CHANGE_ME
# openssl rand -hex 48
JWT_SECRET=CHANGE_ME
JWT_ISSUER=livechat
JWT_AUDIENCE=livechat-app

# ---- Email (console only prints emails to logs, so invites would not arrive) ----
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=no-reply@yourdomain.com

# ---- Cookies ----
COOKIE_DOMAIN=.yourdomain.com
COOKIE_SECURE=true

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
