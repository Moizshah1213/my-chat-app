{
  "name": "@livechat/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/**/*.test.js",
    "test:tenant": "tsx src/__tests__/tenant-isolation.test.ts",
    "test:auth": "tsx src/__tests__/auth.test.ts",
    "test:rbac": "tsx src/__tests__/rbac.test.ts",
    "test:invitations": "tsx src/__tests__/invitations.test.ts",
    "test:http": "tsx src/__tests__/http.test.ts",
    "test:conversations": "tsx src/__tests__/conversations.test.ts",
    "test:realtime": "tsx src/__tests__/realtime.test.ts",
    "test:apikeys": "tsx src/__tests__/api-keys.test.ts",
    "test:settings": "tsx src/__tests__/widget-settings.test.ts",
    "test:phase1": "tsx src/__tests__/tenant-isolation.test.ts && tsx src/__tests__/auth.test.ts && tsx src/__tests__/rbac.test.ts && tsx src/__tests__/invitations.test.ts && tsx src/__tests__/http.test.ts",
    "test:phase2": "tsx src/__tests__/conversations.test.ts && tsx src/__tests__/realtime.test.ts",
    "test:phase3": "tsx src/__tests__/api-keys.test.ts && tsx src/__tests__/widget-settings.test.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@livechat/db": "workspace:*",
    "@livechat/shared": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/websockets": "^10.4.22",
    "@node-rs/argon2": "^2.0.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1",
    "postgres": "^3.4.5",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "rimraf": "^6.0.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
