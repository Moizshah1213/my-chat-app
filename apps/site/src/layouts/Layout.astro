---
// Layout used by all marketing pages (UI spec A+B).
// Usage: <Layout title="..." description="..." canonical="..."><slot /></Layout>
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  bare?: boolean; // true = full-width page (no centered <main> wrapper)
}
const { title, description, canonical, bare = false } = Astro.props;
const url = canonical ?? new URL(Astro.url.pathname, Astro.site ?? 'http://localhost:4321').toString();
const PRODUCT_NAME = 'Qonvilo';

const NAV = [
  { href: '/features', label: 'Features' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/integrations', label: 'Integrations' },
  { href: '/docs', label: 'Docs' },
];
const YEAR = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#08090A" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/qonvilo-mark.png" />
    <link rel="apple-touch-icon" href="/qonvilo-mark.png" />
    <title>{title}</title>
    <style is:global>
      html { color-scheme: dark; }
      body {
        font-family: var(--font-sans);
        background: var(--bg);
        color: var(--text);
        line-height: 1.55;
        margin: 0;
        -webkit-font-smoothing: antialiased;
      }
      header { position: sticky; top: 14px; z-index: 50; padding: 0 16px; height: 52px; }
      .nav {
        display: flex;
        align-items: center;
        gap: 24px;
        max-width: 1040px;
        height: 52px;
        margin: 0 auto;
        padding: 0 8px 0 20px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 999px;
        background: rgba(10, 10, 11, 0.6);
        -webkit-backdrop-filter: blur(14px);
        backdrop-filter: blur(14px);
      }
      .nav .logo {
        display: flex;
        align-items: center;
        text-decoration: none;
      }
      .nav .logo img { display: block; width: auto; height: 40px; }
      .nav .links { display: flex; justify-content: center; gap: 4px; flex: 1; }
      .nav .links a {
        color: var(--muted);
        font-size: 14px;
        font-weight: 500;
        padding: 6px 14px;
        border-radius: 999px;
        text-decoration: none;
        transition: color 0.15s var(--ease), background 0.15s var(--ease);
      }
      .nav .links a:hover { color: var(--text); background: rgba(255, 255, 255, 0.06); }
      .nav .auth { display: flex; align-items: center; gap: 16px; }
      .nav .auth a.login { color: var(--muted); font-size: 14px; font-weight: 500; text-decoration: none; }
      .nav .auth a.login:hover { color: var(--text); }
      .nav .btn-primary { border-radius: 999px; padding: 8px 18px; }
      .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        background: var(--primary-btn-bg);
        color: var(--primary-btn-fg);
        font-weight: 600;
        font-size: 14px;
        padding: 9px 16px;
        border-radius: var(--radius-btn);
        text-decoration: none;
        border: none;
        cursor: pointer;
        font-family: inherit;
        transition: opacity 0.2s var(--ease);
      }
      .btn-primary:hover { opacity: 0.8; text-decoration: none; }
      .btn-outline {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: transparent;
        color: var(--text);
        font-weight: 600;
        font-size: 14px;
        padding: 8px 16px;
        border-radius: var(--radius-btn);
        border: 1px solid var(--border);
        text-decoration: none;
        cursor: pointer;
        font-family: inherit;
        transition: border-color 0.2s var(--ease);
      }
      .btn-outline:hover { border-color: var(--border-hover); text-decoration: none; }
      main { max-width: var(--max-grid); margin: 0 auto; padding: 0 24px; }
      footer {
        border-top: 1px solid var(--border);
        margin-top: 96px;
        padding: 32px 48px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        color: var(--faint);
        font-size: 13px;
      }
      footer nav { display: flex; gap: 18px; }
      .footer-brand { display: flex; align-items: center; gap: 14px; }
      .footer-brand img { display: block; width: auto; height: 34px; }
      footer a { color: var(--faint); text-decoration: none; }
      footer a:hover { color: var(--text); }
      @media (max-width: 720px) {
        header { top: 10px; padding: 0 10px; }
        .nav { padding: 0 6px 0 16px; gap: 12px; justify-content: space-between; }
        .nav .links { display: none; }
        footer { padding: 28px 20px; }
        .footer-brand { flex-wrap: wrap; }
      }
    </style>
  </head>
  <body>
    <header>
      <nav class="nav" aria-label="Main">
        <a class="logo" href="/">
          <img src="/qonvilo-on-dark.png" alt={PRODUCT_NAME} width="649" height="243" />
        </a>
        <div class="links">
          {NAV.map((n) => <a href={n.href}>{n.label}</a>)}
        </div>
        <div class="auth">
          <a class="login" href="/login">Log in</a>
          <a class="btn-primary" href="/signup">Start free</a>
        </div>
      </nav>
    </header>
    {bare ? <div class="bare"><slot /></div> : <main><slot /></main>}
    <footer>
      <div class="footer-brand">
        <img src="/qonvilo-on-dark.png" alt="" width="649" height="243" />
        <span>&copy; {YEAR} {PRODUCT_NAME}. All rights reserved.</span>
      </div>
      <nav aria-label="Legal">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/status">Status</a>
      </nav>
    </footer>
  </body>
</html>