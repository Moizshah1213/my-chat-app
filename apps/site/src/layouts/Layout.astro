---
// Layout used by all pages
// Usage: <Layout title="..." description="..."><slot /></Layout>
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💬</text></svg>" />
  <title>{title}</title>
  <style>
    :root { --bg:#f8fafc; --text:#0f172a; --muted:#475569; --primary:#4f46e5; --border:#e2e8f0; --card:#ffffff; }
    body { font-family: system-ui, -apple-system, sans-serif; background:var(--bg); color:var(--text); line-height:1.6; margin:0; }
    header { background:var(--bg); border-bottom:1px solid var(--border); padding:1rem 2rem; display:flex; justify-content:space-between; align-items:center; }
    nav a { margin-left:1rem; color:var(--primary); text-decoration:none; font-weight:600; }
    main { max-width:1100px; margin:2rem auto; padding:0 2rem; }
    section { background:var(--card); border:1px solid var(--border); border-radius:12px; padding:2rem; margin-bottom:2rem; }
    footer { text-align:center; padding:2rem; color:var(--muted); font-size:0.9rem; }
    .btn { display:inline-block; padding:0.6rem 1.2rem; background:var(--primary); color:#fff; border-radius:8px; text-decoration:none; font-weight:600; margin-top:1rem; }
  </style>
</head>
<body>
  <header>
    <h1>LiveChat</h1>
    <nav>
      <a href="/">Home</a>
      <a href="/features">Features</a>
      <a href="/pricing">Pricing</a>
      <a href="/docs">Docs</a>
      <a href="/contact">Contact</a>
    </nav>
  </header>
  <main>
    <slot />
  </main>
  <footer>
    <p>&copy; 2026 LiveChat. All rights reserved.</p>
  </footer>
</body>
</html>
