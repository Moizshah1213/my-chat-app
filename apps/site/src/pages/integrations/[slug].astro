---
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
  return [
    { params: { slug: 'custom-html' }, props: { name: 'Custom HTML', steps: [
      'Copy your widget key (pk_...) from the dashboard: Settings -> API Keys.',
      'Paste the snippet below just before </body> on every page.',
      'Reload the page - the launcher appears in the corner.',
    ] } },
    { params: { slug: 'wordpress' }, props: { name: 'WordPress', steps: [
      'Copy your widget key (pk_...) from the dashboard: Settings -> API Keys.',
      'In wp-admin, open Appearance -> Theme File Editor and edit footer.php, or use a code-snippet plugin.',
      'Paste the snippet before the closing </body> tag and save.',
      'Visit your site - the widget loads on every page.',
    ] } },
    { params: { slug: 'react' }, props: { name: 'React', steps: [
      'Copy your widget key (pk_...) from the dashboard: Settings -> API Keys.',
      'Add the snippet once in your entry HTML (index.html) or a root component. No wrapper package is needed.',
      'The widget is a plain script - React never re-renders or unmounts it.',
      'Use window.LiveChat.identify({...}) after login to attach visitor identity.',
    ] } },
    { params: { slug: 'nextjs' }, props: { name: 'Next.js', steps: [
      'Copy your widget key (pk_...) from the dashboard: Settings -> API Keys.',
      'In the App Router, add a client component that injects the script once in your root layout; in the Pages Router, add it to _document.js.',
      'Keep data-api-url pointed at your API origin.',
      'Rebuild - the widget appears site-wide.',
    ] } },
  ];
}

const { name, steps } = Astro.props;
const snippet = `<script src="https://cdn.example.com/widget.js"
        data-public-key="pk_..."
        data-api-url="https://api.example.com"
        async></script>`;
---

<Layout
  title={`${name} integration - LiveChat`}
  description={`Install the LiveChat widget on ${name} in minutes - copy-paste snippet included.`}
>
  <section class="page-head">
    <p class="crumb"><a href="/integrations">Integrations</a> <span aria-hidden="true">/</span> {name}</p>
    <h1>{name}</h1>
    <p>Three steps, one snippet - no rebuild of your app required.</p>
  </section>
  <section class="body">
    <ol class="steps">
      {steps.map((s, i) => (
        <li>
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <span>{s}</span>
        </li>
      ))}
    </ol>
    <div class="snippet-card">
      <div class="snippet-head">
        <span class="mono-label">INSTALL SNIPPET</span>
        <button class="btn-outline copy" type="button" data-snippet={snippet}>Copy</button>
      </div>
      <pre><code>{snippet}</code></pre>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('button.copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.snippet ?? '';
      try {
        await navigator.clipboard.writeText(text);
        const prev = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(() => { btn.textContent = prev; }, 1500);
      } catch {
        /* clipboard unavailable - snippet stays selectable */
      }
    });
  });
</script>

<style>
  .page-head { max-width: var(--max-hero); margin: 56px auto 0; animation: fade-up 0.9s var(--ease) both; }
  .page-head h1 { font-size: 52px; line-height: 1.08; letter-spacing: -0.03em; font-weight: 600; margin: 8px 0 0; }
  .page-head p { color: var(--muted); font-size: 17px; margin: 12px 0 0; }
  .crumb { font-family: var(--font-mono); font-size: 12px; color: var(--faint); }
  .crumb a { color: var(--faint); }
  .crumb a:hover { color: var(--text); }
  .body { max-width: 720px; margin: 40px auto 0; }
  .steps { list-style: none; padding: 0; margin: 0 0 32px; display: flex; flex-direction: column; gap: 14px; }
  .steps li { display: flex; gap: 14px; align-items: baseline; color: var(--muted); }
  .steps .num { font-family: var(--font-mono); font-size: 12px; color: var(--faint); flex: none; }
  .snippet-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-card); overflow: hidden; }
  .snippet-head { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border-bottom: 1px solid var(--border); }
  .mono-label { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.05em; color: var(--faint); }
  .copy { padding: 5px 12px; font-size: 12px; }
  pre { margin: 0; padding: 16px; overflow-x: auto; font-family: var(--font-mono); font-size: 13px; color: var(--muted); }
  @media (max-width: 860px) { .page-head h1 { font-size: 36px; } }
</style>
