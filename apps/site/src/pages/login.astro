---
// B.5: auth lives in the dashboard app (:3000) — the site only links out.
import Layout from '../layouts/Layout.astro';
const DASHBOARD = import.meta.env.PUBLIC_DASHBOARD_URL ?? 'http://localhost:3000';
---

<Layout
  title="Log in - LiveChat"
  description="Log in to your LiveChat workspace."
>
  <section class="redirect-card">
    <h1>Log in</h1>
    <p>Signing in opens your workspace dashboard.</p>
    <a class="btn-primary" href={`${DASHBOARD}/login`}>Continue to dashboard</a>
    <p class="alt">No account? <a href="/signup">Create one</a></p>
    <script is:inline define:vars={{ DASHBOARD }}>
      window.location.replace(DASHBOARD + '/login');
    </script>
  </section>
</Layout>

<style>
  .redirect-card {
    max-width: var(--max-form);
    margin: 96px auto 0;
    text-align: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 40px 32px;
    animation: fade-up 0.9s var(--ease) both;
  }
  .redirect-card h1 { font-size: 28px; font-weight: 600; letter-spacing: -0.02em; margin: 0 0 8px; }
  .redirect-card p { color: var(--muted); margin: 0 0 24px; }
  .alt { margin-top: 18px; margin-bottom: 0; font-size: 13px; }
</style>
