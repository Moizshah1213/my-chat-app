{
  "name": "livechat-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant live chat SaaS (working name: livechat). Rename PRODUCT_NAME once decided.",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build && pnpm -r --filter ./apps/** build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @livechat/db generate",
    "db:migrate": "pnpm --filter @livechat/db migrate",
    "db:test:migrate": "pnpm --filter @livechat/db test:migrate"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
