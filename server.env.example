# Copy to ~/app/.env ON THE SERVER and fill in real values. Never commit the real .env.

# --- Database (used by docker-compose) ---
POSTGRES_USER=chat
# generate with: openssl rand -hex 24   (hex only, so the URL never breaks)
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=chat

# --- Domain for HTTPS ---
# With your own domain: api.yourdomain.com
# For testing with no domain: <server-ip>.sslip.io  (example: 1.2.3.4.sslip.io)
API_DOMAIN=api.yourdomain.com

# --- App secrets ---
# Copy the variable NAMES from your repo's .env.example (JWT secret, cookie secret,
# AI keys, allowed origins, etc.) and give each a NEW random value for production:
#   openssl rand -hex 32
# Do not reuse the values from your local .env.
