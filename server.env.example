# ON THE SERVER ONLY: ~/app/.env  (used by docker compose itself)
# Never commit the real file.

# Superuser password for the Postgres container.
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# Hostname Caddy gets an HTTPS certificate for (no http://, no port).
# Own domain: api.yourdomain.com   |   quick test: api.<server-ip>.sslip.io
API_DOMAIN=api.yourdomain.com
